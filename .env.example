# Server
PORT=3000
# static | cognito | both (both = Cognito first, then static fallback)
AUTH_MODE=both

# AWS / Private S3 (IVS automatic recording)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=

# Optional: CloudFront in front of private S3
CLOUDFRONT_DOMAIN=

# Browser origins for S3 CORS (* is ok for GET with presigned URLs)
CORS_ORIGINS=*

# Optional: fallback live URL if IVS ListStreams returns nothing
IVS_PLAYBACK_URL=

# Supabase (used by api/*.js when deployed / wired)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cognito + DynamoDB auth (used when AUTH_MODE=cognito or both, and IDs are set)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
DDB_USERS_TABLE=sw_users
