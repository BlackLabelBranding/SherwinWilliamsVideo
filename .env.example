# Server
PORT=3000
# Cognito-only auth (static users removed)
AUTH_MODE=cognito

# AWS / Private S3 (IVS automatic recording)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=

# Optional: CloudFront in front of private S3
CLOUDFRONT_DOMAIN=

# Browser origins for S3 CORS (* is ok for GET with presigned URLs)
CORS_ORIGINS=*

# Optional: fallback live URL if IVS ListStreams returns nothing
IVS_PLAYBACK_URL=

# Supabase (legacy — unused by Next.js portal)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cognito + DynamoDB auth
# DynamoDB table partition key must be user_id (String)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
DDB_USERS_TABLE=sw_users
DDB_USERS_PK=user_id

# Signed portal sessions (required on Vercel so login survives serverless)
SESSION_SECRET=
